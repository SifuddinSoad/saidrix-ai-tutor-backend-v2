# ===========================================
# Saidrix AI Tutor Server — environment template
# Copy to .env and fill in real values.
# ===========================================

PORT=3000
MONGODB_URI=mongodb://localhost:27017/saidrix-ai-tutor

# --- LLM / agents ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ring-2.6-1t
STRUCTURED_OUTPUT_MODEL=google/gemini-2.5-flash
STRUCTURED_OUTPUT_TIMEOUT_MS=600000
TAVILY_API_KEY=

# --- LiveKit ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_in_production_min_32_chars_xxxx

# --- TTS / STT ---
OPENAI_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=alloy
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# ===========================================
# Authentication
# ===========================================
NODE_ENV=development

# JWT secrets — generate with: openssl rand -hex 32
# REQUIRED in production (>= 32 chars, all different). Server refuses
# to boot in production if any is missing/weak.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_SIGNUP_SECRET=

ACCESS_TOKEN_TTL=15m
SIGNUP_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_TTL_MIN=10
TRIAL_DAYS=3
BCRYPT_COST=12

COOKIE_DOMAIN=
APP_URL=http://localhost:3000

# Production CORS: comma-separated frontend origin(s) allowed to send
# credentialed requests (httpOnly refresh cookie). Leave EMPTY in dev
# (SPA uses the Vite proxy, same-origin). e.g. https://app.saidrix.com
FRONTEND_ORIGIN=

# SMTP — leave SMTP_HOST empty for dev (codes logged to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Saidrix <no-reply@saidrix.local>"
